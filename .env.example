# Optional Google OAuth web client ID; enable Google Drive API and add your app
# origin (http://localhost:3000 for development) to authorized JS origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local production runs only: allows subscription access via installed CLIs.
# Development enables this locally by default. Keep disabled on hosted servers.
ENABLE_LOCAL_AI_SUBSCRIPTIONS=false

# Optional absolute directory for the local SQLite database and snapshots.
# Defaults to ~/Library/Application Support/ResumeBuilder on macOS.
# Keep the same directory across ports and checkouts to share your workspace.
RESUME_BUILDER_DATA_DIR=
